# ============================================================================
# Socratic-OT — environment configuration
# ============================================================================
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control.
#
# This is the single source of truth for every deployment-time knob.
# Anything not in this file is either an internal constant in
# backend/config.py (chunk sizes, paths inside the project) or a
# DOMAIN_CONFIG entry (per-subject prompt slots, generic-word lists).
#
# Recommended local-dev setup:
#   1. Copy → .env
#   2. Set ANTHROPIC_API_KEY (or AWS creds + LLM_PROVIDER=bedrock)
#   3. Set OPENAI_API_KEY only if you're using gpt-4o for vision
#   4. Leave everything else default
#
# Recommended production setup (Cloud Run / Vercel):
#   - Set every key in this file via the platform's env-var UI, NOT a
#     committed .env file
#   - Set CORS_ORIGINS to your real frontend URL
#   - Set SESSIONS_DB_PATH to a mounted volume (so sessions survive
#     container restarts)
#   - Cloud Run injects PORT — do not override
# ============================================================================


# ╭─ 1. PROVIDER & API KEYS ──────────────────────────────────────────────╮
# │ Pick exactly one provider.                                            │
# ╰───────────────────────────────────────────────────────────────────────╯

# Provider: anthropic | bedrock
LLM_PROVIDER=anthropic

# Direct Anthropic API (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — only used if VISION_MODEL=gpt-4o (legacy path; the live
# system uses Claude vision via vlm_node).
OPENAI_API_KEY=

# AWS Bedrock (LLM_PROVIDER=bedrock) — boto3 reads these directly.
# Uncomment if using Bedrock instead of Anthropic.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_PROFILE=default      # alternative to inline creds


# ╭─ 2. MODELS ──────────────────────────────────────────────────────────╮
# │ Leave PRIMARY_MODEL / FAST_MODEL unset to get sensible defaults for   │
# │ the active provider:                                                  │
# │   anthropic → claude-sonnet-4-5 / claude-haiku-4-5                    │
# │   bedrock   → us.anthropic.claude-sonnet-4-5-20250929-v1:0            │
# │              + us.anthropic.claude-haiku-4-5-20251001-v1:0            │
# │ Bedrock IDs need an inference-profile prefix (us./eu./apac./...).    │
# │ Mismatched-format env vars are silently ignored — see config.py.     │
# ╰───────────────────────────────────────────────────────────────────────╯

# PRIMARY_MODEL=
# FAST_MODEL=

# Vision (VLM) — only the vlm_node uses this. Default keeps the historic
# gpt-4o name; production uses Claude vision via VLM_MODEL_OVERRIDE below.
VISION_MODEL=gpt-4o

# Embedding model used at QUERY time (CRAG). Late-chunking is hardcoded
# to nomic-embed-text-v1.5 because chunk vectors must match the index.
EMBED_MODEL=nomic-embed-text


# ╭─ 3. PER-NODE MODEL OVERRIDES (cost optimization) ───────────────────╮
# │ Each Sonnet-tier node can be dialed down to Haiku independently for  │
# │ cost savings or A/B tests. Empty = use PRIMARY_MODEL.                │
# │                                                                       │
# │ Format must match the active provider (anthropic short-name or       │
# │ bedrock inference-profile). Mismatched values are ignored.            │
# │                                                                       │
# │ Cost-relevant ones first; the rest only matter for surgical tuning.  │
# ╰──────────────────────────────────────────────────────────────────────╯

# Teacher node — generates the user-facing Socratic responses. Highest
# call volume. Quality tradeoff: Haiku passes Socratic Purity at 0/7
# but slipped to ~0.81 RAGAS Faithfulness on a small sample (Sonnet
# was 0.88). See evaluation/results/teacher_model_ab.md.
# TEACHER_MODEL_OVERRIDE=

# Dean node — runs on every teacher draft. Bounded structured task
# (5 criteria, JSON output). Strong cost-savings candidate; A/B suggested
# before flipping. Risk: Haiku false-positives on GROUNDING → more
# revision retries → eats the latency win.
# DEAN_MODEL_OVERRIDE=

# Vision node — anatomical-diagram identification + Socratic opener.
# Sonnet only here is the safe default; Haiku vision is acceptable but
# our blind-test data is on Sonnet.
# VLM_MODEL_OVERRIDE=

# Less commonly tuned — defaults to PRIMARY_MODEL.
# STUDY_MODEL_OVERRIDE=
# CLINICAL_MODEL_OVERRIDE=
# TEACH_MODEL_OVERRIDE=
# EXPLAIN_MODEL_OVERRIDE=
# HINT_MODEL_OVERRIDE=
# REDIRECT_MODEL_OVERRIDE=
# STEP_ADVANCER_MODEL_OVERRIDE=
# TOPIC_CHOICE_MODEL_OVERRIDE=
# SYNTHESIS_MODEL_OVERRIDE=


# ╭─ 4. EMBEDDING BACKEND ───────────────────────────────────────────────╮
# │ Cloud Run has no ollama daemon — use "transformers" in production.   │
# │ Local dev can use "ollama" if you have ollama serve running.         │
# ╰──────────────────────────────────────────────────────────────────────╯

EMBED_BACKEND=transformers
EMBED_TRANSFORMERS_MODEL=nomic-ai/nomic-embed-text-v1.5


# ╭─ 5. DOMAIN ──────────────────────────────────────────────────────────╮
# │ Subject the tutor is teaching. Each domain has its own ChromaDB      │
# │ collection ({DOMAIN}_chunks) and prompt slots in DOMAIN_CONFIG.      │
# │ Switching DOMAIN requires:                                            │
# │   - the matching chunks loaded into ChromaDB                         │
# │   - a backend restart (config is read at startup)                    │
# ╰──────────────────────────────────────────────────────────────────────╯

# Options: OT_anatomy | physics
DOMAIN=OT_anatomy


# ╭─ 6. API SERVER ──────────────────────────────────────────────────────╮
# │ Cloud Run injects PORT automatically — leave API_PORT unset there.   │
# ╰──────────────────────────────────────────────────────────────────────╯

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins. Set to your real frontend
# URL in prod. Leave blank in single-origin demos.
CORS_ORIGINS=http://localhost:3000,https://socratic-ot.vercel.app

# Optional regex for preview deploys (e.g. socratic-ot-<hash>.vercel.app)
CORS_ORIGIN_REGEX=https://socratic-ot[a-z0-9-]*\.vercel\.app


# ╭─ 7. SESSION PERSISTENCE ─────────────────────────────────────────────╮
# │ SqliteSaver checkpoints + session_meta table both live in this file. │
# │ Mount a persistent volume in production (Cloud Run: e.g. /mnt/data). │
# ╰──────────────────────────────────────────────────────────────────────╯

# Default = backend/data/sessions.db
# SESSIONS_DB_PATH=/mnt/data/sessions.db


# ╭─ 7b. CROSS-SESSION MEMORY (mem0, optional) ─────────────────────────╮
# │ SqliteSaver always handles per-session conversation state. The mem0  │
# │ layer adds CROSS-session memory: extracts facts from each turn and   │
# │ surfaces them in future sessions ("last time you worked on X").      │
# │                                                                       │
# │ How to enable:                                                        │
# │   1. pip install mem0ai                                              │
# │   2. Sign up at https://mem0.ai → grab API key                       │
# │   3. Set MEMORY_BACKEND=mem0 + MEM0_API_KEY=...                      │
# │   4. Restart backend; verify GET /config shows memory.mem0_enabled   │
# │                                                                       │
# │ Frontend sends a stable per-browser user_id (localStorage) on every  │
# │ chat request — no auth required for the demo.                        │
# │                                                                       │
# │ When MEMORY_BACKEND=sqlite (default), every mem0 call is a no-op so  │
# │ adding the variable later is safe.                                    │
# ╰──────────────────────────────────────────────────────────────────────╯

# sqlite (default — session-only) | mem0 (adds cross-session layer)
MEMORY_BACKEND=sqlite

# MEM0_API_KEY=
# MEM0_TOP_K=4    # how many memories to inject into rapport prompt


# ╭─ 8. TOKEN BUDGETS (per LLM call) ────────────────────────────────────╮
# │ Tune to control cost vs. response richness. Values are caps; the     │
# │ model usually emits less. Defaults reflect the live demo.            │
# ╰──────────────────────────────────────────────────────────────────────╯

TEACHER_MAX_TOKENS=600
DEAN_MAX_TOKENS=300
CLASSIFIER_MAX_TOKENS=10
MANAGER_MAX_TOKENS=150
EXPLAIN_MAX_TOKENS=500
HINT_MAX_TOKENS=500
TEACH_MAX_TOKENS=500
SYNTHESIS_MAX_TOKENS=400
CLINICAL_MAX_TOKENS=400
RAPPORT_MAX_TOKENS=256
VLM_MAX_TOKENS=400
REDIRECT_MAX_TOKENS=300
STEP_ADVANCER_MAX_TOKENS=300
TOPIC_CHOICE_MAX_TOKENS=300
FAITHFULNESS_MAX_TOKENS=800
CRAG_EVAL_MAX_TOKENS=200


# ╭─ 9. NOT IN .env (in code, for awareness) ────────────────────────────╮
# │ The following are deliberately NOT env-driven because changing them  │
# │ silently can break the system. They live in backend/config.py:       │
# │                                                                       │
# │ Socratic gates:                                                       │
# │   SOCRATIC_TURN_GATE = 2          # turn at which reveal is allowed  │
# │   IDK_REVEAL_THRESHOLD = 3        # consecutive idks before reveal   │
# │   DEAN_MAX_REVISIONS = 2          # Dean retries before fallback    │
# │   MAX_RESPONSE_SENTENCES = 3      # before the guiding question     │
# │                                                                       │
# │ Retrieval:                                                            │
# │   TOP_K_RETRIEVE = 15             # candidates from ChromaDB         │
# │   TOP_K_RERANK = 3                # reranker output count            │
# │   WEAK_TOPIC_LOGIT_BOOST = 1.0    # rerank boost for weak topics    │
# │   OUT_OF_SCOPE_THRESHOLD = -8.0   # cross-encoder cutoff             │
# │                                                                       │
# │ CRAG:                                                                 │
# │   CRAG_CORRECT_THRESHOLD = 0.7                                       │
# │   CRAG_INCORRECT_THRESHOLD = 0.3                                     │
# │   CRAG_MAX_REFINEMENTS = 1                                           │
# │                                                                       │
# │ Eval thresholds:                                                      │
# │   FAITHFULNESS_THRESHOLD = 0.85                                      │
# │   BLIND_TEST_PASS_THRESHOLD = 4   # out of 5 diagrams                │
# │                                                                       │
# │ Domain prompt slots (subject_noun, example_concepts, generic_words,  │
# │ stem_blacklist, ...) live in DOMAIN_CONFIG. Add a new domain there.  │
# ╰──────────────────────────────────────────────────────────────────────╯
